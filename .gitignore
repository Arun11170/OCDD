# ===== Crop Advisor (OCDD) .gitignore =====

# --- Data, datasets, models you train (too big / licences: PlantWild is non-commercial) ---
data/
models/
llama/
repos/
logs/
raw/
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.safetensors
*.zip
*.7z
*.tar
*.tar.gz
# exported copies of models (the app's own copies in app/**/assets are kept so the app builds)
export_*/**/*.onnx
export_crops/**/*.onnx
export_lesion_smoke/
*.pte
!app/CropAdvisor/app/src/main/assets/vision_int8.pte
!export/vision_int8.pte

# --- Photos used for tests / previews / checks (not source) ---
testphotos/
testphotos_*/
app_test_photos/
app_test_results/
aar_scan/
**/check/
**/preview*/
docs/sevtest/*.jpg
*.tmp

# --- Work files made while working ---
_app_backup_*/
_backup_*/
_old_assets_*/
_tmp/
**/_tmp/
review/
accuracy_lab_cache.json
accuracy_lab.log
*.log
*.bak
*.bak[0-9]
*_backup.py
*~
*.orig
*.rej

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# --- Android / Gradle / Kotlin ---
**/build/
!**/src/**/build/
**/.gradle/
**/.kotlin/
**/.idea/
*.iml
**/local.properties
*.apk
*.aab
*.keystore
*.jks
captures/
.externalNativeBuild/
.cxx/

# --- Secrets (never commit) ---
.env
.env.*
*.pem
*.key
secrets.*
google-services.json

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
